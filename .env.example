# meeting-notes configuration. Copy to .env and edit.
# Placeholder values only. Never commit real keys.

# Choose a backend: "api" (any OpenAI-compatible endpoint) or "hf" (open models, run locally)
MS_BACKEND=hf

# --- (a) api: bring your own key, any OpenAI-compatible endpoint ---
MS_API_BASE=https://your-provider.example/v1
MS_API_KEY=your-api-key
MS_MODEL=your-chat-model
# Speech-to-text model on an OpenAI-compatible /audio/transcriptions endpoint.
# Leave empty to transcribe locally with faster-whisper (MS_WHISPER_MODEL) and use the API only for notes.
MS_STT_MODEL=
# Optional: a different endpoint or key for speech-to-text (defaults to MS_API_BASE / MS_API_KEY)
MS_STT_API_BASE=
MS_STT_API_KEY=

# --- (b) hf: open-source models from Hugging Face, run locally ---
# Qwen2.5-7B-Instruct needs a GPU or ~32 GB RAM. On a CPU-only machine use the 1.5B model.
MS_HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# MS_HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Weights dtype: auto (bfloat16 on a GPU, float32 on a CPU) | float32 | bfloat16 (half the memory on a CPU)
MS_HF_DTYPE=auto

# --- local speech recognition (hf backend, and api backend when MS_STT_MODEL is empty) ---
# faster-whisper model: large-v3 (default, best with a GPU), large-v3-turbo, medium, small, base
MS_WHISPER_MODEL=large-v3
# MS_WHISPER_MODEL=small
# auto = float16 on a GPU, float32 on a CPU (int8 is smaller but garbled large-v3 output in our CPU tests)
MS_WHISPER_COMPUTE=auto
# Force a language (en, zh, ...). Empty = detect.
MS_LANGUAGE=
# Optional speech context, used by local and API speech-to-text:
# a short prompt (e.g. what the meeting is about) and a comma-separated list of terms that are often said
MS_STT_PROMPT=
MS_STT_HOTWORDS=
# MS_STT_HOTWORDS=sprint, backlog, ticket, login, cache, onboarding, roadmap
# Chinese output script: simplified | traditional | keep
MS_ZH_SCRIPT=simplified

# --- speaker labels ---
# auto = pyannote when installed and HF_TOKEN is set, otherwise sherpa-onnx | sherpa | pyannote | none
MS_DIARIZER=auto
# Number of speakers if known (0 = estimate)
MS_NUM_SPEAKERS=0
# Clustering threshold for sherpa-onnx (higher = fewer speakers)
MS_CLUSTER_THRESHOLD=0.5
# HF_TOKEN=your-hf-token   # only for the gated pyannote/speaker-diarization-3.1

# --- shared ---
MS_THREADS=4
# Where the web demo keeps saved results
MS_CACHE_DIR=.cache/results
# Where diarization models are downloaded
# MS_MODEL_DIR=~/.cache/meeting-notes
